--- /dev/null
+++ b/.github/workflows/sync-upstream.yml
@@ -0,0 +1,115 @@
+name: Sync upstream and keep feature patches
+
+on:
+  workflow_dispatch:
+    inputs:
+      upstream_ref:
+        description: Upstream git ref to sync from
+        required: false
+        default: main
+      create_release:
+        description: Also trigger a release build after sync
+        type: boolean
+        required: false
+        default: true
+  schedule:
+    # Weekly Monday 03:17 UTC
+    - cron: "17 3 * * 1"
+
+permissions:
+  contents: write
+
+concurrency:
+  group: sync-upstream
+  cancel-in-progress: false
+
+env:
+  UPSTREAM_REPO: wxxsfxyzm/MiuiBackGestureHook
+  FEATURE_BRANCH: feature/individual-feature-switches
+  PATCH_FILE: patches/aosp-gesture-restoration-switch.patch
+
+jobs:
+  sync:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout fork
+        uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+          token: ${{ secrets.GITHUB_TOKEN }}
+
+      - name: Configure git identity
+        run: |
+          git config user.name "github-actions[bot]"
+          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
+
+      - name: Fetch upstream
+        run: |
+          git remote add upstream "https://github.com/${UPSTREAM_REPO}.git" || true
+          git fetch upstream --tags --force
+          git fetch origin --tags --force
+
+      - name: Detect upstream changes
+        id: detect
+        run: |
+          REF="${{ github.event.inputs.upstream_ref || 'main' }}"
+          UPSTREAM_SHA="$(git rev-parse "upstream/${REF}")"
+          echo "upstream_sha=${UPSTREAM_SHA}" >> "$GITHUB_OUTPUT"
+          echo "Upstream ${REF} @ ${UPSTREAM_SHA}"
+          if git merge-base --is-ancestor "$UPSTREAM_SHA" HEAD; then
+            echo "changed=false" >> "$GITHUB_OUTPUT"
+            echo "Fork already contains upstream ${REF}."
+          else
+            echo "changed=true" >> "$GITHUB_OUTPUT"
+            echo "Fork is behind upstream ${REF}."
+          fi
+
+      - name: Reset to upstream and re-apply feature patch
+        if: steps.detect.outputs.changed == 'true'
+        run: |
+          REF="${{ github.event.inputs.upstream_ref || 'main' }}"
+          UPSTREAM_SHA="$(git rev-parse "upstream/${REF}")"
+
+          git checkout -B main "$UPSTREAM_SHA"
+
+          # Drop the old feature marker commit if present, then re-apply the
+          # canonical patch so future upstream edits stay reviewable.
+          if [[ -f "$PATCH_FILE" ]]; then
+            chmod +x scripts/ci/apply-feature-patch.sh
+            if ! ./scripts/ci/apply-feature-patch.sh "$PATCH_FILE"; then
+              echo "::error::Feature patch failed to apply on upstream ${REF}."
+              echo "Fix ${PATCH_FILE} against ${UPSTREAM_SHA} and re-run."
+              exit 1
+            fi
+          else
+            echo "::warning::Missing ${PATCH_FILE}; pushing pure upstream."
+          fi
+
+          git add -A
+          if git diff --cached --quiet; then
+            echo "No tree changes after patch application."
+          else
+            git commit -m "chore: sync upstream ${REF}" \
+              -m "Upstream: ${UPSTREAM_REPO}@${UPSTREAM_SHA}" \
+              -m "Re-applied local AOSP predictive-back restoration switch patch."
+          fi
+
+          git branch -f "$FEATURE_BRANCH" main
+          git push origin main
+          git push origin "$FEATURE_BRANCH" --force
+
+      - name: Trigger release workflow
+        if: steps.detect.outputs.changed == 'true' && (github.event_name == 'workflow_dispatch' && github.event.inputs.create_release == 'true' || github.event_name == 'schedule')
+        uses: actions/github-script@v7
+        with:
+          script: |
+            await github.rest.actions.createWorkflowDispatch({
+              owner: context.repo.owner,
+              repo: context.repo.repo,
+              workflow_id: 'release.yml',
+              ref: 'main',
+              inputs: {
+                tag: 'auto',
+                prerelease: 'false'
+              }
+            })
